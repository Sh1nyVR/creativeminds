{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev --workspaces --include-workspace-root && npm install --include=dev --workspace=@scratch/scratch-gui",
  "buildCommand": "npm run build:dev --workspace=@scratch/scratch-gui && node -e \"const f=require('fs');require(f.existsSync('scripts/vercel-finalize.js')?'./scripts/vercel-finalize.js':'../../scripts/vercel-finalize.js')\"",
  "outputDirectory": "build",
  "functions": {
    "api/ov.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/ov/:path*",
      "destination": "/api/ov?path=:path*"
    }
  ]
}
