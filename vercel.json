{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev --workspaces --include-workspace-root && npm install --include=dev --workspace=@scratch/scratch-gui",
  "buildCommand": "node scripts/vercel-runner.js",
  "outputDirectory": "build",
  "functions": {
    "api/ov.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/interstellar/:path*",
      "destination": "/static/interstellar/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/static/interstellar/assets/:path*"
    },
    {
      "source": "/dy/:path*",
      "destination": "/static/interstellar/dy/:path*"
    },
    {
      "source": "/e/:path*",
      "destination": "/static/interstellar/a/q/:path*"
    },
    {
      "source": "/sw.js",
      "destination": "/static/interstellar/sw.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/static/interstellar/robots.txt"
    },
    {
      "source": "/favicon.ico",
      "destination": "/static/interstellar/favicon.ico"
    },
    {
      "source": "/:path*.html",
      "destination": "/static/interstellar/:path*.html"
    },
    {
      "source": "/interstellar",
      "destination": "/static/interstellar/index.html"
    },
    {
      "source": "/ov/:path*",
      "destination": "/api/ov?path=:path*"
    }
  ]
}
